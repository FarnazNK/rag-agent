# Copy to .env and fill in — values here are safe defaults / placeholders.

# --- LLM provider ---
# Pick one. Only set the key for the provider you're using.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Embeddings currently use OpenAI (text-embedding-3-small is cheap and good).
# If you only have an Anthropic key, you'll still need this for retrieval.
OPENAI_API_KEY=sk-...

# --- App config (all optional, defaults in config.py) ---
APP_LLM_PROVIDER=anthropic
APP_LLM_MODEL=claude-sonnet-4-5
APP_LLM_TEMPERATURE=0.0
APP_EMBEDDING_MODEL=text-embedding-3-small

APP_TOP_K_DENSE=8
APP_TOP_K_SPARSE=8
APP_TOP_K_FINAL=4
APP_MIN_RELEVANCE_SCORE=0.2
APP_MAX_ITERATIONS=3

APP_LOG_LEVEL=INFO

# --- Optional: LangSmith tracing ---
# If unset, the agent still runs — it just logs to stderr instead of LangSmith.
# LANGSMITH_API_KEY=lsv2_pt_...
# APP_LANGSMITH_PROJECT=rag-agent
